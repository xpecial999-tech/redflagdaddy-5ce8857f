{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redflagdaddy",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "staging": {
      "name": "redflagdaddy-staging",
      "vars": {
        "CONSTRUCTION_MODE": "disabled",
      },
      "routes": [
        {
          "pattern": "staging.redflagdaddy.com",
          "custom_domain": true,
        },
      ],
    },
    "production": {
      "name": "redflagdaddy-production",
      "vars": {
        "CONSTRUCTION_MODE": "enabled",
      },
      "workers_dev": true,
      "routes": [
        {
          "pattern": "redflagdaddy.com",
          "custom_domain": true,
        },
      ],
    },
  },
}
